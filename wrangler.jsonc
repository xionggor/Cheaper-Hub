{
  "name": "friends-game-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding":"DB","database_name":"friends-game-hub","database_id":"REPLACE_WITH_YOUR_D1_DATABASE_ID"}],
  "durable_objects": {"bindings":[{"name":"ROOM","class_name":"GameRoom"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["GameRoom"]}]
}
